# ==============================================================================
# MyProdigy Environment Configuration
# Copy this file to .env before starting development services.
# ==============================================================================

# --- Database Setup (PostgreSQL) ---
POSTGRES_USER=prodigy
POSTGRES_PASSWORD=prodigy_pass
POSTGRES_DB=prodigy_db
DB_PORT=5433

# Connection string used by backend inside docker-compose
DATABASE_URL=postgres://prodigy:prodigy_pass@db:5432/prodigy_db?sslmode=disable

# Connection string for host-machine connections (e.g. CLI migrations or DB clients)
# DATABASE_URL_LOCAL=postgres://prodigy:prodigy_pass@localhost:5433/prodigy_db?sslmode=disable


# --- Go Backend ---
PORT=8080
FRONTEND_URL=http://localhost:3000


# --- Next.js Frontend ---
# NEXTAUTH_URL should point to the base URL of your frontend
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret key used to sign and encrypt JWTs. 
# Generate a secure random value in production using: `openssl rand -base64 32`
NEXTAUTH_SECRET=super-secret-nextauth-token-key-change-me-in-production

# Next.js API client environment variables
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
